{
  "uid": "model-service-overview",
  "title": "Model service overview",
  "tags": [
    "mlops",
    "model-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
