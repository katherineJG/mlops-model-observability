      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(observation_sink_failures_total{job=\"model-service\"}[15m])) or vector(0)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
