      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"model-service\", status_class=\"5xx\"}[5m])) / sum(rate(http_requests_total{job=\"model-service\"}[5m]))",
          "legendFormat": "5xx share",
          "format": "time_series",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#174bc4",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "#174bc4"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 latency of /predict (alert above 0.5 s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"model-service\", route=\"/predict\"}[5m])))",
          "legendFormat": "p95",
          "format": "time_series",
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#174bc4",
                "value": null
