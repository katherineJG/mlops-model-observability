          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "drift": {
                  "color": "orange"
                },
                "invalid_input": {
                  "color": "red"
                },
                "no_drift": {
                  "color": "green"
                },
                "insufficient_data": {
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
